generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  /// STUDENT | PARENT | TEACHER | ADMIN
  role         String   @default("STUDENT")
  grade        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]
  sessions     LiveSession[] @relation("TeacherSessions")
  progress     Progress[]
  children     ParentChild[] @relation("Parent")
  parents      ParentChild[] @relation("Child")
  attempts     Attempt[]
  gradeEntries GradeEntry[]
  reportCards  ReportCard[]
  teacherGrades TeacherGrade[]
  writtenSubmissions WrittenSubmission[] @relation("StudentSubmissions")
  gradedSubmissions  WrittenSubmission[] @relation("GradedByTeacher")
  createdThreads     MessageThread[]     @relation("ThreadCreator")
  threadMemberships  ThreadParticipant[]
  messagesSent       Message[]
  unitUnlockOverrides UnitUnlockOverride[]
  unitUnlocksCreated  UnitUnlockOverride[] @relation("UnitUnlockCreatedBy")
}

model ParentChild {
  id       String @id @default(cuid())
  parentId String
  childId  String
  parent   User   @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  child    User   @relation("Child", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
}

/// Grades a teacher is cleared to teach (roster, catalog, scheduling).
model TeacherGrade {
  id        String   @id @default(cuid())
  teacherId String
  grade     Int
  createdAt DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, grade])
  @@index([teacherId])
}

model Plan {
  id            String  @id @default(cuid())
  name          String
  description   String
  priceMonthly  Int
  stripePriceId String?
  /// ELEMENTARY | MIDDLE | HIGH
  gradeBand     String
  active        Boolean @default(true)
  enrollments   Enrollment[]
}

model Enrollment {
  id                   String   @id @default(cuid())
  userId               String
  planId               String
  grade                Int
  /// PENDING | ACTIVE | PAST_DUE | UNPAID | PAUSED | CANCELED
  status               String   @default("PENDING")
  stripeSubscriptionId String?
  stripeCustomerId     String?
  demoMode             Boolean  @default(false)
  scholarship          Boolean  @default(false)
  startedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model Course {
  id          String @id @default(cuid())
  title       String
  description String
  subject     String
  grade       Int
  /// ELEMENTARY | MIDDLE | HIGH
  gradeBand   String
  order       Int    @default(0)
  /// false = hidden from student/teacher/catalog (e.g. G10 electives; rows kept)
  published   Boolean @default(true)

  lessons      Lesson[]
  sessions     LiveSession[]
  quizzes      Quiz[]
  gradeEntries GradeEntry[]
  writtenSubmissions WrittenSubmission[]
  messageThreads     MessageThread[]
  unitUnlockOverrides UnitUnlockOverride[]
}

model Lesson {
  id          String @id @default(cuid())
  courseId    String
  title       String
  description String
  /// Full lesson body in Markdown (objectives + teach + examples + practice)
  content     String @default("")
  /// Short bullet-style learning goals (plain text or markdown)
  objectives  String @default("")
  order       Int    @default(0)
  durationMin Int    @default(30)
  /// Exact YouTube (or equivalent) video length in seconds when known; drives M:SS labels
  videoDurationSec Int?
  /// Section grouping key, e.g. "section-1" (lessons 1–3)
  sectionKey  String @default("section-1")
  /// Optional YouTube (or equivalent) lesson video URL for iframe embed
  videoUrl    String?

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Progress[]
  questions Question[]
  attempts  Attempt[]
  writtenSubmissions WrittenSubmission[]
  messageThreads MessageThread[]
}

model LiveSession {
  id              String   @id @default(cuid())
  title           String
  description     String
  teacherId       String
  courseId        String?
  grade           Int?
  scheduledAt     DateTime
  durationMinutes Int      @default(45)
  meetingUrl      String?
  jitsiRoomSlug   String
  createdAt       DateTime @default(now())

  teacher User    @relation("TeacherSessions", fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// Graded multiple-choice item for a lesson check or section quiz
model Question {
  id           String @id @default(cuid())
  lessonId     String?
  quizId       String?
  /// MULTIPLE_CHOICE
  type         String @default("MULTIPLE_CHOICE")
  prompt       String
  /// JSON array of 4 choice strings [A,B,C,D]
  choices      String
  correctIndex Int
  explanation  String @default("")
  points       Int    @default(1)
  order        Int    @default(0)

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Quiz {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String  @default("")
  order       Int     @default(0)
  /// e.g. "section-1" — unlocks after all lessons in that section are complete
  sectionKey  String?

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  Attempt[]
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String?
  quizId      String?
  score       Float
  maxScore    Float
  percent     Float
  /// JSON map of questionId -> selectedIndex
  answers     String
  submittedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model GradeEntry {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  /// LESSON_QUIZ | SECTION_QUIZ | WRITTEN | OTHER
  source   String
  refId    String
  score    Float
  maxScore Float
  percent  Float
  weight   Float    @default(1)
  gradedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, source, refId])
}

model ReportCard {
  id           String   @id @default(cuid())
  userId       String
  periodStart  DateTime
  periodEnd    DateTime
  generatedAt  DateTime @default(now())
  /// JSON: course averages, overall %, letter grades, progress proxy, comments
  summary      String
  pdfPath      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
}


/// Teacher-scored constructed response (essay, fix-and-justify, math reasoning, science write-up)
model WrittenSubmission {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  lessonId        String?
  /// Stable key for upserting / finding a student's response to a prompt
  promptKey       String
  title           String
  prompt          String
  body            String
  /// SUBMITTED | GRADED | RETURNED
  status          String    @default("SUBMITTED")
  score           Float?
  maxScore        Float     @default(10)
  percent         Float?
  teacherFeedback String?
  gradedById      String?
  submittedAt     DateTime  @default(now())
  gradedAt        DateTime?

  user     User    @relation("StudentSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  gradedBy User?   @relation("GradedByTeacher", fields: [gradedById], references: [id], onDelete: SetNull)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([courseId, userId, status])
  @@index([status])
}

/// Idempotency store for Stripe webhook events (primary key = Stripe event.id)
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// Lightweight notification stub (e.g. payment_failed alerts)
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}

/// In-app message thread: DM between two users, teacher BLAST, or classroom GROUP
model MessageThread {
  id          String   @id @default(cuid())
  subject     String
  /// DM | BLAST | GROUP
  type        String
  createdById String
  courseId    String?
  /// Set when the thread was opened from Ask your teacher. Not a message body.
  lessonId    String?
  grade       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                @relation("ThreadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson       Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  participants ThreadParticipant[]
  messages     Message[]

  @@index([createdById])
  @@index([type, grade])
  @@index([courseId])
  @@index([lessonId])
}

model ThreadParticipant {
  id         String    @id @default(cuid())
  threadId   String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
}

/// Admin/teacher override: unlock Grade 6 units ahead of sequential gate for one student+course.
/// maxUnlockedUnit = N means units 1..N are open regardless of prior-unit completion.
model UnitUnlockOverride {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  maxUnlockedUnit  Int
  note             String   @default("")
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User   @relation("UnitUnlockCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}
