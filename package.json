{
  "name": "prosper-prep-online-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "node scripts/clean-cloudflare.mjs && opennextjs-cloudflare build",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:cloudflare": "wrangler d1 migrations apply prosperprep-school --remote",
    "admin:provision": "node scripts/provision-admin.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:setup": "prisma db push && node --import tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "qc:content": "tsx scripts/check-content.ts",
    "qc:courses": "tsx scripts/report-courses.ts",
    "qc:counts": "tsx scripts/qc-counts.ts",
    "qc:depth": "tsx scripts/qc-depth.ts",
    "qc:showcase-quizzes": "tsx scripts/verify-showcase-quizzes.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.1.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.140.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
